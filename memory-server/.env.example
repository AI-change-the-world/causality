# Memory Server Environment Configuration
# Copy this file to .env and update values as needed

# ============================================
# Docker Compose Configuration
# ============================================
# These are only used by docker-compose.yml for container setup

# Memory Server exposed port
MEMORY_SERVER_PORT=8080

# PostgreSQL container settings
POSTGRES_USER=memory
POSTGRES_PASSWORD=memory
POSTGRES_DB=memory_db
POSTGRES_PORT=5432

# Qdrant container exposed ports
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Logging level
RUST_LOG=info

# ============================================
# Configuration Files
# ============================================
# Application configuration is in config/*.yaml:
#
# - config/config.yaml        : Development mode (localhost URLs)
# - config/config.docker.yaml : Docker mode (internal network URLs)
#
# Docker containers automatically use config.docker.yaml
# For local development, the default config.yaml is used
#
# To override, set CONFIG_PATH environment variable:
# CONFIG_PATH=config/config.yaml cargo run

# ============================================
# Provider Configuration
# ============================================
# Embedding and LLM providers are managed via API:
# - POST /api/v1/config/providers     - Create embedding provider
# - POST /api/v1/config/llm-providers - Create LLM provider
#
# API keys are stored securely in the database.
# No need to configure provider API keys in environment variables.
