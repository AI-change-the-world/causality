# Memory Server Environment Configuration
# Copy this file to .env and update values as needed

# ============================================
# Run Mode Configuration
# ============================================
# debug: Memory Server runs locally, connects to containers via exposed ports
# release: Memory Server runs in container, connects via internal docker network
RUN_MODE=debug

# ============================================
# Memory Server Configuration
# ============================================
MEMORY_SERVER_PORT=8080
RUST_LOG=info

# ============================================
# PostgreSQL Configuration
# ============================================
POSTGRES_USER=memory
POSTGRES_PASSWORD=memory
POSTGRES_DB=memory_db
POSTGRES_PORT=5432

# Database URL for different modes:
# - debug mode (local development): connects to localhost with exposed port
# - release mode (docker): connects to container via internal network
#
# DEBUG mode (uncomment when running locally):
# DATABASE_URL=postgres://memory:memory@localhost:5432/memory_db
#
# RELEASE mode (used in docker-compose.yml):
# DATABASE_URL=postgres://memory:memory@postgres:5432/memory_db

# ============================================
# Qdrant Configuration
# ============================================
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Qdrant URL for different modes:
# - debug mode (local development): connects to localhost with exposed port
# - release mode (docker): connects to container via internal network
#
# DEBUG mode (uncomment when running locally):
# QDRANT_URL=http://localhost:6334
#
# RELEASE mode (used in docker-compose.yml):
# QDRANT_URL=http://qdrant:6334

# ============================================
# Provider Configuration
# ============================================
# Embedding and LLM providers are managed via API:
# - POST /api/v1/config/providers - Create embedding provider
# - POST /api/v1/config/llm-providers - Create LLM provider
#
# API keys are stored securely in the database.
# No need to configure provider API keys in environment variables.
